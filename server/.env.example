NODE_ENV=development
PORT=5000
# MongoDB Atlas connection string — replace with your own
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/personal-os
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-64-hex-chars
JWT_REFRESH_SECRET=replace-with-64-hex-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
# In development: the Vite dev server. In production (single-service
# deploy where Express serves client/dist): your public app URL,
# e.g. https://your-app.onrender.com
CLIENT_URL=http://localhost:5173
